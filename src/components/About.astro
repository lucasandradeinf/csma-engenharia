---
import SectionHead from './ui/SectionHead.astro';
import { about } from '../data/site';
---

<section class="chapter about is-alt" id="a-csma" aria-labelledby="about-title">
  <div class="blueprint" aria-hidden="true"></div>

  <div class="shell">
    <SectionHead num="01" eyebrow={about.eyebrow} title={about.title} id="about-title" />

    <div class="about__grid">
      <div class="about__spine" aria-hidden="true">
        <span class="about__spine-line"></span>
        <span class="about__spine-dot"></span>
      </div>

      <p class="about__lead" data-reveal>{about.lead}</p>

      <div class="about__blocks">
        {
          about.blocks.map((b, i) => (
            <article class="about__block" data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <div class="about__block-head">
                <span class="index-mark">{b.idx}</span>
                <h3 class="about__block-title mono">{b.label}</h3>
              </div>
              <span class="about__block-rule" data-rule style={`--reveal-delay:${i * 120 + 120}ms`} />
              <p class="about__block-text">{b.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .about__spine {
    display: none;
  }

  .about__lead {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.98rem + 1.05vw, 1.9375rem);
    line-height: 1.34;
    letter-spacing: -0.014em;
    color: var(--ink-strong);
    max-width: 26ch;
  }

  .about__blocks {
    display: grid;
    gap: var(--space-lg);
  }

  .about__block-head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: var(--space-xs);
  }
  .about__block-title {
    color: var(--ink-strong);
    letter-spacing: 0.14em;
  }
  .about__block-rule {
    display: block;
    height: 1px;
    background: var(--rule-strong);
    margin-bottom: var(--space-sm);
  }
  .about__block-text {
    color: var(--ink-muted);
    max-width: 44ch;
  }

  @media (min-width: 62rem) {
    .about__grid {
      grid-template-columns: var(--rail) minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
      align-items: start;
    }
    .about__spine {
      display: block;
      position: relative;
      align-self: stretch;
      min-height: 12rem;
    }
    .about__spine-line {
      position: absolute;
      left: 0;
      top: 0.5rem;
      bottom: 0;
      width: 1px;
      background: linear-gradient(to bottom, var(--rule-strong), transparent);
    }
    .about__spine-dot {
      position: absolute;
      left: -5px;
      top: 0.6rem;
      width: 11px;
      height: 1px;
      background: var(--accent);
    }
    .about__lead {
      max-width: 32ch;
      font-size: clamp(1.375rem, 1.05rem + 1vw, 2rem);
    }
    .about__blocks {
      gap: var(--space-xl);
      padding-top: 0.4rem;
    }
  }
</style>
