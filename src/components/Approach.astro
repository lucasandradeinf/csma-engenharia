---
import { approach } from '../data/site';
---

<section class="chapter approach" id="abordagem" aria-labelledby="approach-title">
  <div class="shell">
    <div class="ap__intro">
      <div class="ap__rail" data-reveal>
        <span class="index-mark">03</span>
        <span class="ap__rail-tick" aria-hidden="true"></span>
      </div>

      <div class="ap__statement">
        <div class="ap__heading" data-reveal>
          <p class="eyebrow eyebrow--bare ap__eyebrow">{approach.eyebrow}</p>
          <h2 class="ap__title" id="approach-title">{approach.statement}</h2>
        </div>
        <p class="ap__lead" data-reveal style="--reveal-delay:140ms">{approach.lead}</p>
      </div>
    </div>


    <!-- Cadeia: da engenharia à execução -->
    <div class="ap__chain" data-observe aria-hidden="true">
      <span class="ap__chain-track">
        <i data-rule></i>
      </span>

      <ol class="ap__stations">
        {
          approach.chain.map((s, i) => (
            <li class="ap__station" data-node style={`--node-delay:${360 + i * 180}ms`}>
              <span class="ap__station-label">
                <span class="index-mark">{s.idx}</span>
                <span class="ap__station-name">{s.label}</span>
              </span>
              <span class="ap__station-stem" />
              <span class="ap__station-node" />
            </li>
          ))
        }
      </ol>
    </div>

    <!-- equivalente acessível da cadeia -->
    <ol class="visually-hidden">
      {approach.chain.map((s) => <li>{`${s.idx} — ${s.label}`}</li>)}
    </ol>
  </div>
</section>

<style>
  .approach {
    background: var(--c-white);
    overflow: hidden;
  }

  /* ---------- Enunciado ---------- */
  .ap__intro {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .ap__rail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ap__rail-tick {
    display: block;
    height: 1px;
    width: 2.5rem;
    background: var(--rule-strong);
  }
  .ap__eyebrow {
    display: block;
    margin-bottom: var(--space-xs);
    color: var(--ink-faint);
  }

  .ap__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.05rem + 4.2vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.024em;
    color: var(--ink-strong);
    max-width: 14ch;
  }

  .ap__lead {
    margin-top: var(--space-md);
    max-width: 44ch;
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.58;
    color: var(--ink-muted);
  }

  /* ---------- Cadeia ---------- */
  .ap__chain {
    position: relative;
  }

  .ap__chain-track {
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    overflow: hidden;
  }
  .ap__chain-track i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--rule-strong);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1400ms var(--ease-out) 200ms;
  }
  .ap__chain.is-in .ap__chain-track i {
    transform: scaleY(1);
  }

  .ap__stations {
    display: grid;
    gap: var(--space-lg);
  }

  .ap__station {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-left: 2rem;
  }
  .ap__station-node {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 13px;
    height: 13px;
    border: 1px solid var(--ink-strong);
    background: var(--surface);
  }
  .ap__station:last-child .ap__station-node {
    background: var(--ink-strong);
  }
  .ap__station-stem {
    display: none;
  }
  .ap__station-label {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .ap__station-name {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.9rem + 1.1vw, 1.625rem);
    line-height: 1.2;
    color: var(--ink-strong);
  }

  /* ---------- Desktop: cadeia horizontal ---------- */
  @media (min-width: 62rem) {
    .ap__intro {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: start;
    }
    .ap__rail {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      padding-top: 0.8rem;
    }
    .ap__rail-tick {
      width: 3.5rem;
    }
    .ap__statement {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-2xl);
      align-items: end;
    }
    .ap__lead {
      margin-top: 0;
      padding-bottom: 0.6rem;
    }

    .ap__chain {
      padding-block: var(--space-lg);
    }
    .ap__chain-track {
      left: 10%;
      right: 10%;
      top: 50%;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .ap__chain-track i {
      transform: scaleX(0);
      transform-origin: left;
    }
    .ap__chain.is-in .ap__chain-track i {
      transform: scaleX(1);
    }

    .ap__stations {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
    }
    .ap__station {
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      justify-items: center;
      align-items: center;
      gap: 0;
      padding-left: 0;
      min-height: 15rem;
      text-align: center;
    }
    .ap__station-node {
      position: static;
      grid-row: 2;
      width: 15px;
      height: 15px;
    }
    .ap__station-stem {
      display: block;
      position: absolute;
      left: 50%;
      width: 1px;
      height: 2.25rem;
      background: var(--rule-strong);
      opacity: 0.7;
    }
    .ap__station-label {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      max-width: 12.5rem;
    }

    /* alternância acima / abaixo da linha */
    .ap__station:nth-child(odd) .ap__station-label {
      grid-row: 1;
      align-self: start;
      padding-top: 0.5rem;
    }
    .ap__station:nth-child(odd) .ap__station-stem {
      bottom: calc(50% + 8px);
    }
    .ap__station:nth-child(even) .ap__station-label {
      grid-row: 3;
      align-self: end;
      padding-bottom: 0.5rem;
    }
    .ap__station:nth-child(even) .ap__station-stem {
      top: calc(50% + 8px);
    }
  }
</style>
