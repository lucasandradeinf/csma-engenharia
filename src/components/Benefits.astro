---
import SectionHead from './ui/SectionHead.astro';
import { benefits } from '../data/site';

/* O capitulo fecha o raciocinio aberto em "O desafio dos projetos industriais":
   a situacao que se repete no campo, e o que a CSMA entrega no lugar dela.
   Sem siglas e sem legenda — a leitura tem que funcionar sozinha. */
---

<section class="chapter benefits is-alt" id="resultados" aria-labelledby="benefits-title">
  <div class="shell">
    <SectionHead
      num="12"
      eyebrow={benefits.eyebrow}
      title={benefits.title}
      id="benefits-title"
      lead={benefits.lead}
    />

    <div class="bf__table">
      <div class="bf__legend" aria-hidden="true">
        <span class="mono bf__legend-before">{benefits.columns.before}</span>
        <span class="mono bf__legend-after">{benefits.columns.after}</span>
      </div>

      <ol class="bf__rows">
        {
          benefits.items.map((item) => (
            <li class="bf__row" data-reveal>
              <p class="bf__before">
                <span class="visually-hidden">{benefits.columns.before}: </span>
                {item.before}
              </p>

              <span class="bf__link" aria-hidden="true">
                <span class="bf__link-rule" />
                <svg class="bf__link-arrow" width="9" height="12" viewBox="0 0 9 12" fill="none">
                  <path d="M4.5 0v10M1 7l3.5 3.5L8 7" stroke="currentColor" stroke-width="1" />
                </svg>
              </span>

              <p class="bf__after">
                <span class="visually-hidden">{benefits.columns.after}: </span>
                {item.after}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .benefits {
    background: var(--surface);
  }

  .bf__table {
    border-top: 1px solid var(--rule-strong);
  }

  .bf__legend {
    display: none;
  }

  .bf__rows {
    display: grid;
  }

  .bf__row {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--rule);
  }

  .bf__before {
    color: var(--ink-faint);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 46ch;
  }

  /* A seta é a própria afirmação: a situação vira resultado. */
  .bf__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent);
  }
  .bf__link-rule {
    display: block;
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .bf__link-arrow {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  .bf__after {
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 0.95rem + 1.2vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink-strong);
    max-width: 30ch;
  }

  /* ---------- Desktop: duas colunas, leitura da esquerda para a direita ---------- */
  @media (min-width: 62rem) {
    .bf__legend {
      display: grid;
      grid-template-columns: minmax(0, 0.66fr) 4.5rem minmax(0, 1.34fr);
      align-items: baseline;
      padding-block: var(--space-sm);
      border-bottom: 1px solid var(--rule);
      color: var(--ink-faint);
    }
    .bf__legend-before {
      letter-spacing: 0.18em;
    }
    .bf__legend-after {
      grid-column: 3;
      letter-spacing: 0.18em;
      color: var(--ink);
    }

    .bf__row {
      grid-template-columns: minmax(0, 0.66fr) 4.5rem minmax(0, 1.34fr);
      align-items: center;
      gap: 0;
      padding-block: var(--space-lg);
    }
    .bf__before {
      padding-right: var(--space-md);
      max-width: none;
    }
    .bf__link {
      justify-content: center;
    }
    .bf__link-rule {
      width: 1.5rem;
    }
    .bf__link-arrow {
      transform: rotate(-90deg);
    }
  }

  @media (hover: hover) and (min-width: 62rem) {
    .bf__row:hover .bf__link-arrow {
      transform: rotate(-90deg) translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bf__link-arrow {
      transition: none;
    }
  }
</style>
