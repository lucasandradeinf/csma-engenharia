---
import Logo from './ui/Logo.astro';
import { closing, site } from '../data/site';
import { buildFrame } from '../lib/iso';

/* Eco da abertura: o mesmo módulo axonométrico, agora ao fundo, quase apagado. */
const f = buildFrame({ axes: [0, 150, 300, 450, 600], depth: 170, mid: 110, top: 210 });
const lines = [...f.columns, ...f.beamsLong, ...f.beamsCross, ...f.braces];
---

<section class="cta is-dark is-dark--deep" id="contato" aria-labelledby="cta-title">
  <div class="cta__echo" aria-hidden="true">
    <svg viewBox="-155 -220 682 320" fill="none" preserveAspectRatio="xMidYMin meet">
      <path d={f.base.d} />
      {lines.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />)}
    </svg>
  </div>
  <div class="cta__field" aria-hidden="true"></div>

  <div class="shell cta__inner">
    <div class="cta__brand" data-observe>
      <Logo class="cta__logo" title="CSMA" animated />
      <p class="cta__signature mono">{site.signatureUpper}</p>
    </div>

    <h2 class="cta__statement" id="cta-title" data-reveal>{closing.statement}</h2>

    <div class="cta__actions" data-reveal style="--reveal-delay:120ms">
      <a class="btn cta__btn" href={closing.cta.href}>
        <span>{closing.cta.label}</span>
        <span class="btn__arrow" aria-hidden="true">
          <svg width="18" height="8" viewBox="0 0 18 8" fill="none">
            <path d="M0 4h16M13 1l3 3-3 3" stroke="currentColor" stroke-width="1"></path>
          </svg>
        </span>
      </a>

      <a class="cta__mail" href={`mailto:${site.email}`}>
        <span class="mono cta__mail-label">E-mail</span>
        <span class="cta__mail-value tlink">{site.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--c-navy-deep);
    color: #fff;
    padding-block: var(--space-3xl);
    overflow: hidden;
    isolation: isolate;
  }

  .cta__echo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6%;
    z-index: -2;
  }
  .cta__echo svg {
    width: 116%;
    margin-left: -8%;
    height: auto;
  }
  .cta__echo line,
  .cta__echo path {
    stroke: rgba(94, 135, 176, 0.5);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    fill: none;
  }

  /* Escurece o topo para o texto e libera a base para a estrutura aparecer. */
  .cta__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(7, 21, 39, 0.97) 0%,
      rgba(7, 21, 39, 0.93) 48%,
      rgba(7, 21, 39, 0.62) 78%,
      rgba(7, 21, 39, 0.45) 100%
    );
  }

  .cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-lg);
  }

  .cta__brand {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    width: 100%;
  }
  .cta__brand :global(.cta__logo) {
    width: min(78%, 26rem);
    color: #fff;
  }
  .cta__signature {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.5625rem;
    letter-spacing: 0.24em;
  }

  .cta__statement {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 0.95rem + 2.5vw, 3.25rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 20ch;
    margin-top: var(--space-lg);
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .cta__mail {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }
  .cta__mail-label {
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.2em;
  }
  .cta__mail-value {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: #fff;
    letter-spacing: 0.04em;
  }

  @media (min-width: 48rem) {
    .cta__actions {
      flex-direction: row;
      gap: var(--space-xl);
      align-items: center;
    }
    .cta__mail {
      justify-items: start;
      text-align: left;
    }
  }
</style>
