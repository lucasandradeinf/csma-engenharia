---
import SectionHead from './ui/SectionHead.astro';
import { challenge } from '../data/site';

/* Diagrama conceitual: trajetoria planejada x trajetoria realizada.
   Sem escalas e sem numeros — e uma representacao esquematica, nao um dado. */
const PLAN = { x1: 40, y1: 252, x2: 392, y2: 68 };
const ACTUAL = [
  [40, 252],
  [110, 220],
  [180, 202],
  [250, 186],
  [320, 168],
  [392, 152],
] as const;

const faults = challenge.items.map((item, i) => {
  const [x, y] = ACTUAL[i + 1]!;
  return { ...item, x, y };
});

const actualPath = ACTUAL.map((p, i) => `${i === 0 ? 'M' : 'L'}${p[0]} ${p[1]}`).join(' ');
const areaPath = `${actualPath} L${PLAN.x2} ${PLAN.y2} L${PLAN.x1} ${PLAN.y1} Z`;
---

<section
  class="chapter challenge is-dark is-dark--deep"
  id="desafio"
  aria-labelledby="challenge-title"
  data-challenge
>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="shell">
    <SectionHead
      num="02"
      eyebrow={challenge.eyebrow}
      title={challenge.title}
      id="challenge-title"
    />

    <div class="ch__grid">
      <!-- Diagrama -->
      <div class="ch__viz">
        <figure class="ch__figure" data-observe>
          <svg viewBox="0 0 432 300" fill="none" role="img" aria-labelledby="ch-viz-title">
            <title id="ch-viz-title">
              Diagrama esquemático: à medida que o projeto avança, a trajetória realizada
              se afasta da planejada a cada ponto de falha identificado.
            </title>

            <!-- moldura -->
            <g class="ch__frame">
              <line x1="40" y1="24" x2="40" y2="272" />
              <line x1="40" y1="272" x2="404" y2="272" />
              {[76, 128, 180, 232].map((y) => <line class="ch__grid-line" x1="40" y1={y} x2="404" y2={y} />)}
            </g>

            <!-- area de desvio -->
            <path class="ch__area" d={areaPath} data-node style="--node-delay:900ms" />

            <!-- trajetoria planejada -->
            <line
              class="ch__plan"
              x1={PLAN.x1}
              y1={PLAN.y1}
              x2={PLAN.x2}
              y2={PLAN.y2}
              pathLength="1"
              data-draw
              style="--draw-delay:120ms"
            />
            <!-- trajetoria realizada -->
            <path class="ch__actual" d={actualPath} pathLength="1" data-draw style="--draw-delay:420ms" />

            <!-- pontos de falha -->
            {
              faults.map((f, i) => (
                <g class="ch__fault" data-fault={f.code} data-node style={`--node-delay:${1000 + i * 110}ms`}>
                  <line class="ch__drop" x1={f.x} y1={f.y} x2={f.x} y2="272" />
                  <circle class="ch__halo" cx={f.x} cy={f.y} r="11" />
                  <circle class="ch__dot" cx={f.x} cy={f.y} r="4" />
                  <text class="ch__code" x={f.x} y="288" text-anchor="middle">{f.code}</text>
                </g>
              ))
            }

            <!-- rótulos -->
            <text class="ch__axis" x="398" y={PLAN.y2 - 12} text-anchor="end">Planejado</text>
            <text class="ch__axis ch__axis--warn" x="398" y="140" text-anchor="end">Realizado</text>
            <text class="ch__axis ch__axis--muted" x="40" y="18">Desvio acumulado</text>
          </svg>

          <figcaption class="mono ch__note">Representação esquemática</figcaption>
        </figure>
      </div>

      <!-- Pontos de falha, em texto -->
      <ol class="ch__list">
        {
          challenge.items.map((item) => (
            <li class="ch__item" data-item={item.code} data-reveal>
              <div class="ch__item-head">
                <span class="index-mark ch__item-code">{item.code}</span>
                <span class="ch__item-line" aria-hidden="true" />
              </div>
              <h3 class="h-item ch__item-title">{item.title}</h3>
              <p class="ch__item-text">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .challenge {
    background: var(--c-navy-deep);
  }

  .ch__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  /* ---------- Diagrama ---------- */
  .ch__figure {
    margin: 0;
    max-width: 34rem;
  }
  .ch__figure svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ch__frame line {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 0.9;
  }
  .ch__grid-line {
    stroke: rgba(255, 255, 255, 0.06) !important;
  }

  .ch__area {
    fill: var(--c-steel);
    fill-opacity: 0.12;
  }

  .ch__plan {
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 0.9;
    stroke-dasharray: 0.012 0.01;
  }
  .ch__actual {
    stroke: #fff;
    stroke-width: 1.5;
    fill: none;
  }

  .ch__drop {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 0.9;
    stroke-dasharray: 2 3;
  }
  .ch__halo {
    fill: none;
    stroke: var(--c-steel);
    stroke-width: 0.9;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .ch__dot {
    fill: var(--c-navy-deep);
    stroke: #fff;
    stroke-width: 1.5;
    transition: fill var(--dur) var(--ease-out), stroke var(--dur) var(--ease-out);
  }
  .ch__code {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    fill: rgba(255, 255, 255, 0.34);
    transition: fill var(--dur) var(--ease-out);
  }

  .ch__fault.is-active .ch__halo {
    opacity: 1;
    transform: scale(1);
  }
  .ch__fault.is-active .ch__dot {
    fill: #fff;
    stroke: #fff;
  }
  .ch__fault.is-active .ch__code {
    fill: #fff;
  }

  .ch__axis {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(255, 255, 255, 0.6);
  }
  .ch__axis--warn {
    fill: #fff;
  }
  .ch__axis--muted {
    fill: rgba(255, 255, 255, 0.32);
  }

  .ch__note {
    margin-top: var(--space-sm);
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
  }

  /* ---------- Lista ---------- */
  .ch__list {
    display: grid;
    gap: var(--space-lg);
  }
  .ch__item {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--rule);
    transition: opacity var(--dur) var(--ease-out);
  }
  .ch__item-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: var(--space-xs);
  }
  .ch__item-code {
    color: var(--c-steel);
  }
  .ch__item-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .ch__item-title {
    margin-bottom: 0.4rem;
  }
  .ch__item-text {
    color: var(--ink-muted);
    max-width: 42ch;
    font-size: var(--fs-base);
  }

  /* ---------- Desktop: diagrama fixo, falhas rolando ---------- */
  @media (min-width: 64rem) {
    .ch__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      gap: var(--space-2xl);
      align-items: start;
    }
    .ch__viz {
      position: sticky;
      top: calc(var(--header-h) + 12vh);
    }
    .ch__list {
      gap: 0;
    }
    .ch__item {
      padding-block: clamp(2.5rem, 6vh, 4.5rem);
      border-top: 1px solid var(--rule);
      opacity: 0.42;
    }
    .ch__item:first-child {
      padding-top: 0;
      border-top: 0;
    }
    .ch__item:last-child {
      padding-bottom: 0;
    }
    .ch__item.is-current {
      opacity: 1;
    }
    .ch__item-title {
      transition: transform var(--dur) var(--ease-out);
    }
    .ch__item.is-current .ch__item-title {
      transform: translateX(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch__item {
      opacity: 1 !important;
    }
    .ch__item-title {
      transform: none !important;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-challenge]');

  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-item]'));
    const faults = new Map(
      Array.from(section.querySelectorAll<SVGGElement>('[data-fault]')).map((el) => [
        el.dataset.fault!,
        el,
      ])
    );

    const setCurrent = (code: string | null) => {
      items.forEach((el) => el.classList.toggle('is-current', el.dataset.item === code));
      faults.forEach((el, key) => el.classList.toggle('is-active', key === code));
    };

    const io = new IntersectionObserver(
      (entries) => {
        /* O item cuja area visivel esta mais proxima do centro assume o foco. */
        let best: { code: string; ratio: number } | null = null;
        entries.forEach((e) => {
          const code = (e.target as HTMLElement).dataset.item!;
          if (e.isIntersecting && (!best || e.intersectionRatio > best.ratio)) {
            best = { code, ratio: e.intersectionRatio };
          }
        });
        if (best) setCurrent((best as { code: string }).code);
      },
      { rootMargin: '-42% 0px -42% 0px', threshold: [0, 0.5, 1] }
    );

    items.forEach((el) => io.observe(el));
    if (items[0]) setCurrent(items[0].dataset.item!);
  }
</script>
