---
import { constructibility } from '../data/site';

/* Capitulo de posicionamento.
   A obra e percorrida uma vez no modelo antes de ser percorrida no canteiro:
   engenharia · modelo · simulacao · sequenciamento · validacao · execucao.
   A soleira desenhada antes da ultima etapa e a mobilizacao — o ponto em que
   mudar de ideia deixa de ser revisao de projeto e vira retrabalho. */
const stages = constructibility.stages;
---

<section
  class="chapter cb is-dark"
  id="construtibilidade"
  aria-labelledby="constructibility-title"
>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="shell cb__grid">
    <!-- Enunciado -->
    <div class="cb__aside">
      <div class="cb__aside-inner">
        <div class="cb__rail" data-reveal>
          <span class="index-mark">03</span>
          <span class="cb__rail-tick" aria-hidden="true"></span>
        </div>

        <p class="eyebrow eyebrow--bare cb__eyebrow" data-reveal>{constructibility.eyebrow}</p>

        <h2 class="cb__chapter" id="constructibility-title" data-reveal>
          {constructibility.chapter}
        </h2>

        <p class="cb__title" data-reveal style="--reveal-delay:100ms">{constructibility.title}</p>

        <p class="cb__lead" data-reveal style="--reveal-delay:180ms">{constructibility.lead}</p>

        <p class="cb__note" data-reveal style="--reveal-delay:260ms">
          <span class="cb__note-rule" aria-hidden="true"></span>
          <span>{constructibility.note}</span>
        </p>
      </div>
    </div>

    <!-- Descida: da engenharia à execução real -->
    <div class="cb__flow" data-observe>
      <span class="cb__spine" aria-hidden="true"><i data-rule></i></span>

      <ol class="cb__stages">
        {
          stages.map((s) => {
            const isReal = 'real' in s && s.real;
            return (
              <li class:list={['cb__stage', isReal && 'cb__stage--real']} data-reveal>
                {isReal && (
                  <div class="cb__threshold" aria-hidden="true">
                    <span class="mono cb__threshold-before">{constructibility.boundary.before}</span>
                    <span class="cb__threshold-line" />
                    <span class="mono cb__threshold-after">{constructibility.boundary.after}</span>
                  </div>
                )}
                <span class="index-mark cb__stage-num">{s.idx}</span>
                <h3 class="cb__stage-label">{s.label}</h3>
                <p class="cb__stage-text">{s.text}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .cb {
    background: var(--c-navy);
  }

  .cb__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  /* ---------- Enunciado ---------- */
  .cb__rail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
  }
  .cb__rail-tick {
    display: block;
    height: 1px;
    width: 2.5rem;
    background: var(--rule-strong);
  }

  .cb__eyebrow {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--ink-faint);
  }

  .cb__chapter {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.15rem + 3.2vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 13ch;
  }

  /* A frase de posicionamento, logo abaixo do título do capítulo. */
  .cb__title {
    margin-top: var(--space-md);
    padding-left: var(--space-md);
    border-left: 1px solid var(--c-steel);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.5rem);
    line-height: 1.28;
    color: #fff;
    max-width: 26ch;
  }

  .cb__lead {
    margin-top: var(--space-md);
    color: var(--ink-muted);
    font-size: var(--fs-base);
    line-height: 1.68;
    max-width: 44ch;
  }

  .cb__note {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    color: var(--ink-faint);
    font-size: var(--fs-sm);
    line-height: 1.62;
    max-width: 42ch;
  }
  .cb__note-rule {
    display: block;
    width: 3.5rem;
    height: 1px;
    background: var(--rule-strong);
  }

  /* ---------- Descida ---------- */
  .cb__flow {
    position: relative;
  }

  .cb__spine {
    position: absolute;
    left: 0;
    top: 0.55rem;
    bottom: 1.4rem;
    width: 1px;
    overflow: hidden;
  }
  .cb__spine i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--rule-strong);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1500ms var(--ease-out) 150ms;
  }
  .cb__flow.is-in .cb__spine i {
    transform: scaleY(1);
  }

  .cb__stages {
    display: grid;
  }

  .cb__stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'threshold threshold'
      'num       label'
      '.         text';
    column-gap: 0.9rem;
    row-gap: 0.3rem;
    padding: var(--space-md) 0 var(--space-md) var(--space-md);
  }
  .cb__stage:first-child { padding-top: 0; }
  .cb__stage:last-child { padding-bottom: 0; }

  /* Marcador: um traço que cruza o fio, ancorado no número da etapa —
     assim acompanha a soleira sem precisar de medida em JavaScript.
     Nada de caixas: o índice do cliente pediu marca, não checklist. */
  .cb__stage-num {
    grid-area: num;
    position: relative;
    color: var(--ink-faint);
    padding-top: 0.34rem;
  }
  .cb__stage-num::before {
    content: '';
    position: absolute;
    left: calc(var(--space-md) * -1 - 5px);
    top: 0.72rem;
    width: 11px;
    height: 1px;
    background: var(--rule-strong);
  }
  .cb__stage-label {
    grid-area: label;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.875rem);
    line-height: 1.16;
    letter-spacing: -0.014em;
    color: #fff;
  }
  .cb__stage-text {
    grid-area: text;
    color: var(--ink-muted);
    font-size: var(--fs-base);
    max-width: 40ch;
  }

  /* ---------- Soleira: a mobilização ---------- */
  .cb__threshold {
    grid-area: threshold;
    display: grid;
    gap: 0.55rem;
    margin: 0 0 var(--space-md) calc(var(--space-md) * -1);
    padding-top: var(--space-xs);
  }
  .cb__threshold-line {
    display: block;
    height: 0;
    border-top: 1px dashed rgba(255, 255, 255, 0.26);
  }
  .cb__threshold-before,
  .cb__threshold-after {
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }
  .cb__threshold-after {
    color: rgba(255, 255, 255, 0.8);
  }

  /* A execução real: a única etapa que acontece fora do modelo. */
  .cb__stage--real .cb__stage-num::before {
    left: calc(var(--space-md) * -1 - 8px);
    width: 17px;
    background: #fff;
  }
  .cb__stage--real .cb__stage-num {
    color: var(--c-steel);
  }
  .cb__stage--real .cb__stage-label {
    font-size: clamp(1.375rem, 1.05rem + 1.4vw, 2.125rem);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 62rem) {
    .cb__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--space-3xl);
      align-items: start;
    }
    .cb__aside-inner {
      position: sticky;
      top: calc(var(--header-h) + 12vh);
    }

    .cb__stage {
      padding-block: clamp(1.5rem, 3.2vh, 2.25rem);
      grid-template-columns: 3.25rem minmax(0, 1fr);
      column-gap: 0;
    }
    /* A soleira atravessa a coluna inteira; os rótulos ficam à direita. */
    .cb__threshold {
      grid-template-columns: minmax(0, 1fr);
      justify-items: end;
      gap: 0.4rem;
      margin-bottom: var(--space-lg);
    }
    .cb__threshold-line {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb__spine i {
      transform: scaleY(1) !important;
    }
  }
</style>
