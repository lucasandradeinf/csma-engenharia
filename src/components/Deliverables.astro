---
import SectionHead from './ui/SectionHead.astro';
import { deliverables, site } from '../data/site';
---

<section class="chapter deliverables" id="entregaveis" aria-labelledby="deliverables-title">
  <div class="shell">
    <SectionHead
      num="07"
      eyebrow={deliverables.eyebrow}
      title={deliverables.title}
      id="deliverables-title"
      lead={deliverables.lead}
    />

    <ul class="dl__matrix" data-reveal-group>
      {
        deliverables.items.map((item) => (
          <li class="dl__cell">
            <span class="dl__idx index-mark">{item.idx}</span>
            <h3 class="dl__title">{item.title}</h3>
          </li>
        ))
      }
    </ul>

    <!-- carimbo de prancha -->
    <div class="dl__block" data-reveal>
      <span class="mono dl__block-item">CSMA</span>
      <span class="dl__block-sep" aria-hidden="true"></span>
      <span class="mono dl__block-item dl__block-item--wide">{site.signatureUpper}</span>
    </div>
  </div>
</section>

<style>
  .deliverables {
    background: var(--c-white);
  }

  .dl__matrix {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--rule-strong);
  }

  .dl__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 9.5rem;
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    border-bottom: 1px solid var(--rule);
  }

  .dl__idx {
    color: var(--accent);
  }

  .dl__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.008em;
    color: var(--ink-strong);
    max-width: 18ch;
  }

  .dl__block {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
  }
  .dl__block-item {
    letter-spacing: 0.22em;
    color: var(--ink);
  }
  .dl__block-item--wide {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }
  .dl__block-sep {
    width: 1px;
    height: 1rem;
    background: var(--rule-strong);
  }

  @media (min-width: 40rem) {
    .dl__matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
  @media (min-width: 64rem) {
    .dl__matrix {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .dl__cell {
      min-height: 11rem;
      padding-block: var(--space-lg);
    }
  }
</style>
