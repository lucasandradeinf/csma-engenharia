---
import SectionHead from './ui/SectionHead.astro';
import { deliverables, site } from '../data/site';
---

<section
  class="chapter deliverables is-dark is-dark--deep"
  id="entregaveis"
  aria-labelledby="deliverables-title"
>
  <div class="blueprint" aria-hidden="true"></div>

  <div class="shell">
    <SectionHead
      num="07"
      eyebrow={deliverables.eyebrow}
      title={deliverables.title}
      id="deliverables-title"
    />

    <ul class="dl__matrix" data-reveal-group>
      {
        deliverables.items.map((item) => (
          <li class="dl__cell">
            <span class="dl__code index-mark">{item.code}</span>
            <h3 class="dl__title">{item.title}</h3>
            <span class="dl__cross" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M6.5 0v13M0 6.5h13" stroke="currentColor" stroke-width="1" />
              </svg>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- carimbo de prancha -->
    <div class="dl__block" data-reveal>
      <span class="mono dl__block-item">CSMA</span>
      <span class="dl__block-sep" aria-hidden="true"></span>
      <span class="mono dl__block-item dl__block-item--wide">{site.signatureUpper}</span>
    </div>
  </div>
</section>

<style>
  .deliverables {
    background: var(--c-navy-deep);
  }

  .dl__matrix {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }

  .dl__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 11rem;
    padding: var(--space-md);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    transition: background-color var(--dur) var(--ease-out);
  }
  .dl__cell:hover {
    background: rgba(255, 255, 255, 0.028);
  }

  .dl__code {
    color: var(--c-steel);
    letter-spacing: 0.16em;
  }

  .dl__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.5rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: #fff;
    max-width: 18ch;
  }

  /* cruzeta de canto, como marca de encontro de eixos na prancha */
  .dl__cross {
    position: absolute;
    right: -7px;
    bottom: -7px;
    color: var(--c-steel);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
    z-index: 1;
  }
  .dl__cell:hover .dl__cross {
    opacity: 0.9;
  }

  .dl__block {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
  }
  .dl__block-item {
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.62);
  }
  .dl__block-item--wide {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }
  .dl__block-sep {
    width: 1px;
    height: 1rem;
    background: var(--rule-strong);
  }

  @media (min-width: 40rem) {
    .dl__matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .dl__matrix {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .dl__cell {
      min-height: 14rem;
      padding: var(--space-md) var(--space-md) var(--space-lg);
    }
  }
</style>
