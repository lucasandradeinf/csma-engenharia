---
import Logo from './ui/Logo.astro';
import { chapters, site } from '../data/site';
---

<header class="hd" id="cabecalho" data-header>
  <div class="hd__bg" aria-hidden="true"></div>

  <div class="shell hd__inner">
    <a class="hd__brand" href="#topo" aria-label="CSMA — início">
      <Logo class="hd__logo" />
    </a>

    <nav class="hd__nav" aria-label="Navegação principal">
      <ul>
        {
          chapters.slice(0, 6).map((item) => (
            <li>
              <a href={item.href} data-spy={item.href}>
                <span class="hd__nav-idx">{item.idx}</span>
                <span class="hd__nav-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="hd__cta" href={`mailto:${site.email}`}>
      <span>Fale conosco</span>
      <svg width="13" height="7" viewBox="0 0 13 7" fill="none" aria-hidden="true">
        <path d="M0 3.5h11.4M8.6.6l2.9 2.9-2.9 2.9" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </a>

    <button
      class="hd__burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-burger
    >
      <span class="visually-hidden">Abrir índice</span>
      <span class="hd__burger-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="hd__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<!-- Índice em tela cheia: estrutura editorial de uma apresentação técnica.
     Um fio vertical contínuo, capítulos numerados, item corrente marcado
     por peso e por um traço. Sem caixas e sem checklist. -->
<div class="mm" id="menu-mobile" data-menu hidden>
  <nav class="mm__nav" aria-label="Índice dos capítulos">
    <p class="mono mm__label">Índice</p>

    <ul class="mm__list">
      {
        chapters.map((item) => (
          <li>
            <a href={item.href} data-menu-link data-spy={item.href}>
              <span class="mm__idx">{item.idx}</span>
              <span class="mm__label-text">{item.label}</span>
              <span class="mm__tick" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mm__foot">
    <a class="mm__mail tlink" href={`mailto:${site.email}`} data-menu-link>{site.email}</a>
    <p class="mono mm__sig">{site.signatureUpper}</p>
  </div>
</div>

<style>
  /* ------------------------------------------------------------------ */
  .hd {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    color: #fff;
  }

  .hd__bg {
    position: absolute;
    inset: 0;
    background: rgba(1, 25, 59, 0.94);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateY(-100%);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .hd.is-stuck .hd__bg {
    opacity: 1;
    transform: none;
  }

  .hd__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: var(--header-h);
  }

  .hd__brand {
    display: block;
    flex: none;
    width: 96px;
    color: #fff;
  }
  .hd__brand :global(.hd__logo) {
    width: 100%;
    transition: opacity var(--dur) var(--ease-out);
  }
  .hd__brand:hover :global(.hd__logo) {
    opacity: 0.72;
  }

  .hd__nav {
    display: none;
    margin-inline: auto;
  }
  .hd__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.9vw, 2.1rem);
  }
  .hd__nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro-tight);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    padding-block: 0.4rem;
    transition: color var(--dur) var(--ease-out);
  }
  .hd__nav a:hover,
  .hd__nav a:focus-visible,
  .hd__nav a.is-current {
    color: #fff;
  }
  .hd__nav-idx {
    font-size: 0.5625rem;
    color: rgba(255, 255, 255, 0.42);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur) var(--ease-out);
  }
  .hd__nav a.is-current .hd__nav-idx {
    color: var(--c-steel);
  }
  .hd__nav-label {
    position: relative;
  }
  .hd__nav-label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }
  .hd__nav a:hover .hd__nav-label::after,
  .hd__nav a:focus-visible .hd__nav-label::after,
  .hd__nav a.is-current .hd__nav-label::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hd__cta {
    display: none;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    padding: 0.7rem 1.05rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro-tight);
    text-transform: uppercase;
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }
  .hd__cta svg {
    transition: transform var(--dur) var(--ease-out);
  }
  .hd__cta:hover,
  .hd__cta:focus-visible {
    background: #fff;
    color: var(--c-navy);
    border-color: #fff;
  }
  .hd__cta:hover svg,
  .hd__cta:focus-visible svg {
    transform: translateX(3px);
  }

  .hd__burger {
    margin-left: auto;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .hd__burger-lines {
    display: block;
    width: 22px;
  }
  .hd__burger-lines i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out), width var(--dur) var(--ease-out);
  }
  .hd__burger-lines i:first-child {
    width: 22px;
    margin-bottom: 6px;
  }
  .hd__burger-lines i:last-child {
    width: 14px;
    margin-left: auto;
  }
  .hd__burger[aria-expanded='true'] i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .hd__burger[aria-expanded='true'] i:last-child {
    width: 22px;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .hd__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
  }
  .hd__progress span {
    display: block;
    height: 100%;
    background: rgba(255, 255, 255, 0.55);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .hd.is-stuck .hd__progress span {
    opacity: 1;
  }

  @media (min-width: 62rem) {
    .hd__nav,
    .hd__cta {
      display: flex;
    }
    .hd__burger {
      display: none;
    }
    .hd__brand {
      width: 108px;
    }
  }

  /* ------------------------------------------------------------------
     Índice em tela cheia
     ------------------------------------------------------------------ */
  .mm {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--c-navy);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-h) + var(--space-lg)) var(--gutter) var(--space-lg);
    opacity: 0;
    overflow-y: auto;
    transition: opacity 340ms var(--ease-out);
  }
  .mm[hidden] {
    display: none;
  }
  .mm.is-open {
    opacity: 1;
  }

  .mm__nav {
    position: relative;
    margin-top: auto;
    margin-bottom: auto;
  }
  .mm__label {
    color: rgba(255, 255, 255, 0.48);
    letter-spacing: 0.24em;
    margin-bottom: var(--space-md);
  }

  /* Fio vertical contínuo — o índice é uma coluna, não uma lista de caixas. */
  .mm__list {
    position: relative;
    padding-left: var(--space-md);
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .mm__list a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.55rem, 2.1vw, 0.9rem);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out),
      color var(--dur) var(--ease-out);
    color: rgba(255, 255, 255, 0.66);
  }
  .mm.is-open .mm__list a {
    opacity: 1;
    transform: none;
  }
  .mm.is-open li:nth-child(1) a { transition-delay: 70ms; }
  .mm.is-open li:nth-child(2) a { transition-delay: 110ms; }
  .mm.is-open li:nth-child(3) a { transition-delay: 150ms; }
  .mm.is-open li:nth-child(4) a { transition-delay: 190ms; }
  .mm.is-open li:nth-child(5) a { transition-delay: 230ms; }
  .mm.is-open li:nth-child(6) a { transition-delay: 270ms; }
  .mm.is-open li:nth-child(7) a { transition-delay: 310ms; }

  .mm__list a.is-current,
  .mm__list a:hover,
  .mm__list a:focus-visible {
    color: #fff;
  }

  /* Marcador do capítulo corrente: um traço que entra a partir do fio. */
  .mm__tick {
    position: absolute;
    left: calc(var(--space-md) * -1);
    top: 50%;
    width: calc(var(--space-md) - 0.4rem);
    height: 1px;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .mm__list a.is-current .mm__tick {
    transform: scaleX(1);
  }

  .mm__idx {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro-tight);
    color: rgba(255, 255, 255, 0.42);
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .mm__list a.is-current .mm__idx {
    color: var(--c-steel);
  }
  .mm__label-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 6.4vw, 2.25rem);
    line-height: 1.16;
    letter-spacing: -0.014em;
  }

  .mm__foot {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: none;
  }
  .mm__mail {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: #fff;
    align-self: flex-start;
  }
  .mm__sig {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  @media (prefers-reduced-motion: reduce) {
    .hd__bg,
    .mm,
    .mm__list a {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  /* --- Estado do cabecalho + barra de progresso ---------------------- */
  if (header) {
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-stuck', y > 48);

      if (progress) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.setProperty('--p', max > 0 ? String(Math.min(y / max, 1)) : '0');
      }
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  /* --- Capitulo corrente ---------------------------------------------
     O indice acompanha a leitura: o item ativo e o ultimo capitulo cujo
     topo ja passou pela linha de leitura (um terco da altura da janela). */
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));

  if (spyLinks.length) {
    const targets = spyLinks
      .map((a) => a.dataset.spy!)
      .filter((href, i, all) => all.indexOf(href) === i)
      .map((href) => ({ href, el: document.querySelector<HTMLElement>(href) }))
      .filter((t): t is { href: string; el: HTMLElement } => Boolean(t.el));

    let spying = false;

    const spy = () => {
      const line = window.innerHeight * 0.34;
      let current = '';
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= line) current = t.href;
      }
      spyLinks.forEach((a) => a.classList.toggle('is-current', a.dataset.spy === current));
      spying = false;
    };

    const onSpy = () => {
      if (spying) return;
      spying = true;
      requestAnimationFrame(spy);
    };

    spy();
    window.addEventListener('scroll', onSpy, { passive: true });
    window.addEventListener('resize', onSpy, { passive: true });
  }

  /* --- Indice em tela cheia ------------------------------------------- */
  if (burger && menu) {
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      burger.setAttribute('aria-expanded', String(open));
      burger.querySelector('.visually-hidden')!.textContent = open
        ? 'Fechar índice'
        : 'Abrir índice';
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        const done = () => {
          if (!open) menu.hidden = true;
          menu.removeEventListener('transitionend', done);
        };
        menu.addEventListener('transitionend', done);
        window.setTimeout(done, 420);
      }
    };

    burger.addEventListener('click', () => setOpen(!open));
    menu.querySelectorAll('[data-menu-link]').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        burger.focus();
      }
    });
    /* O indice em tela cheia so existe abaixo de 62rem. */
    window.matchMedia('(min-width: 62rem)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }
</script>
