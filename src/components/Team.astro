---
import SectionHead from './ui/SectionHead.astro';
import { team } from '../data/site';

/* Fase 2: a constelação de nós saiu.
   Um grafo de rede lia como diagrama de software, não como equipe de obra —
   o capítulo agora se apoia no único número real do material (+100 anos) e
   na lista das especialidades, com espaço para respirar. */
---

<section class="chapter team is-alt" id="equipe" aria-labelledby="team-title" data-team>
  <div class="shell">
    <SectionHead num="08" eyebrow={team.eyebrow} title={team.title} id="team-title" lead={team.lead} />

    <div class="tm__grid">
      <!-- Experiência acumulada -->
      <div class="tm__aside">
        <div class="tm__metric" data-observe>
          <p class="tm__metric-value">
            <span aria-hidden="true">{team.metric.prefix}</span><span
              data-count
              data-count-to={team.metric.value}>{team.metric.value}</span
            >
            <span class="tm__metric-unit">{team.metric.unit}</span>
          </p>
          <span class="tm__metric-rule" data-rule></span>
          <p class="tm__metric-caption">{team.metricCaption}</p>
        </div>
      </div>

      <!-- Especialidades -->
      <div class="tm__roles">
        <ol>
          {
            team.roles.map((role, i) => (
              <li class="tm__role" data-reveal style={`--reveal-delay:${i * 55}ms`}>
                <span class="index-mark tm__role-num">{role.idx}</span>
                <span class="tm__role-title">{role.title}</span>
                <span class="tm__role-rule" aria-hidden="true" />
              </li>
            ))
          }
        </ol>
        <p class="tm__footnote mono">{team.footnote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .tm__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  /* ---------- Experiência acumulada ---------- */
  .tm__metric {
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule-strong);
  }
  .tm__metric-value {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 6vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums;
  }
  .tm__metric-unit {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-xs);
  }
  .tm__metric-rule {
    display: block;
    height: 1px;
    background: var(--rule-strong);
    margin: var(--space-md) 0;
    max-width: 12rem;
  }
  .tm__metric-caption {
    color: var(--ink-muted);
    font-size: var(--fs-base);
    max-width: 30ch;
  }

  /* ---------- Especialidades ---------- */
  .tm__roles ol {
    border-top: 1px solid var(--rule-strong);
  }
  .tm__role {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }
  .tm__role-num {
    flex: none;
    color: var(--accent);
  }
  .tm__role-title {
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.36;
    color: var(--ink-strong);
    transition: transform var(--dur) var(--ease-out);
  }
  .tm__role-rule {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--ink-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 560ms var(--ease-out);
  }
  .tm__role:hover .tm__role-rule {
    transform: scaleX(1);
  }
  .tm__role:hover .tm__role-title {
    transform: translateX(6px);
  }

  .tm__footnote {
    margin-top: var(--space-md);
    color: var(--ink-faint);
    letter-spacing: 0.14em;
  }

  @media (min-width: 64rem) {
    .tm__grid {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: var(--space-3xl);
      align-items: start;
    }
    .tm__metric {
      position: sticky;
      top: calc(var(--header-h) + 14vh);
    }
    .tm__role {
      padding-block: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tm__role-title {
      transform: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-team]');

  if (root) {
    /* Contador da métrica — o único número do material institucional. */
    const counter = root.querySelector<HTMLElement>('[data-count]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (counter && !reduced) {
      const target = Number(counter.dataset.countTo || '0');
      counter.textContent = '0';

      const run = () => {
        const duration = 1500;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          counter.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            run();
            io.disconnect();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(counter);
    }
  }
</script>
