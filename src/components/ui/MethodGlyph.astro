---
/**
 * Glifos tecnicos das etapas da Metodologia CSMA.
 * Desenho monolinear, mesma gramatica do restante do site: 160x160,
 * traco 1.2, sem preenchimento, sem icones genericos de biblioteca.
 */
interface Props {
  name: 'diagnostico' | 'eap' | 'bim' | 'workshop' | 'ataque' | 'relatorio';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 160 160"
  fill="none"
  aria-hidden="true"
  stroke="currentColor"
  stroke-width="1.2"
>
  {
    name === 'diagnostico' && (
      <g>
        {/* folha de documento com canto dobrado */}
        <path d="M28 18h58l20 20v82H28z" class="g-soft" />
        <path d="M86 18v20h20" class="g-soft" />
        {/* conteudo */}
        <path d="M42 56h50M42 70h50M42 84h32" class="g-faint" />
        {/* lupa / leitura critica */}
        <circle cx="106" cy="102" r="28" class="g-key" />
        <path d="M106 82v40M86 102h40" class="g-key" />
        <path d="M126 122l14 14" class="g-key" />
      </g>
    )
  }

  {
    name === 'eap' && (
      <g>
        {/* estrutura analitica: no raiz e tres pacotes */}
        <rect x="62" y="16" width="36" height="16" class="g-key" />
        <path d="M80 32v14M26 46h108M26 46v10M80 46v10M134 46v10" class="g-soft" />
        <rect x="10" y="56" width="32" height="14" class="g-soft" />
        <rect x="64" y="56" width="32" height="14" class="g-soft" />
        <rect x="118" y="56" width="32" height="14" class="g-soft" />
        {/* cronograma */}
        <path d="M14 88h132" class="g-faint" />
        <path d="M22 100h44M50 114h58M84 128h50" class="g-key" />
        {/* histograma */}
        <path d="M14 150h132M28 150v-8M50 150v-14M72 150v-20M94 150v-13M116 150v-7" class="g-faint" />
      </g>
    )
  }

  {
    name === 'bim' && (
      <g>
        {/* volume isometrico */}
        <path d="M80 22 142 58 142 118 80 154 18 118 18 58Z" class="g-soft" />
        <path d="M80 22 80 86M80 86 142 58M80 86 18 58" class="g-key" />
        {/* fatias de sequenciamento (4D) */}
        <path d="M18 84 80 120 142 84" class="g-faint" stroke-dasharray="4 4" />
        <path d="M18 102 80 138 142 102" class="g-faint" stroke-dasharray="4 4" />
        {/* eixo do tempo */}
        <path d="M18 140h34M46 135l6 5-6 5" class="g-key" />
      </g>
    )
  }

  {
    name === 'workshop' && (
      <g>
        {/* mesa de validacao multidisciplinar */}
        <circle cx="80" cy="80" r="46" class="g-soft" />
        <circle cx="80" cy="80" r="7" class="g-key" />
        {/* disciplinas convergindo */}
        <path d="M80 34v39M114 55 88 76M126 94 89 84M104 118 85 87M56 118 75 87M34 94 71 84M46 55 72 76" class="g-faint" />
        {/* nos das disciplinas */}
        <rect x="75" y="24" width="10" height="10" class="g-key" />
        <rect x="112" y="45" width="10" height="10" class="g-key" />
        <rect x="126" y="86" width="10" height="10" class="g-key" />
        <rect x="99" y="118" width="10" height="10" class="g-key" />
        <rect x="51" y="118" width="10" height="10" class="g-key" />
        <rect x="24" y="86" width="10" height="10" class="g-key" />
        <rect x="38" y="45" width="10" height="10" class="g-key" />
      </g>
    )
  }

  {
    name === 'ataque' && (
      <g>
        {/* planta da area */}
        <path d="M20 34h120v92H20z" class="g-soft" />
        <path d="M60 34v92M100 34v92M20 80h120" class="g-faint" />
        {/* frentes de servico */}
        <path d="M4 58h30M28 53l6 5-6 5" class="g-key" />
        <path d="M4 104h70M68 99l6 5-6 5" class="g-key" />
        <path d="M156 80h-36M126 75l-6 5 6 5" class="g-key" />
        {/* prioridade */}
        <path d="M36 66h16M36 112h16M110 88h16" class="g-faint" />
        <circle cx="40" cy="46" r="4" class="g-key" />
        <circle cx="80" cy="92" r="4" class="g-key" />
        <circle cx="120" cy="46" r="4" class="g-key" />
      </g>
    )
  }

  {
    name === 'relatorio' && (
      <g>
        {/* caderno de recomendacoes */}
        <path d="M40 22h84v104H40z" class="g-faint" />
        <path d="M28 34h84v104H28z" class="g-soft" />
        <path d="M28 34v104" class="g-key" />
        <path d="M42 58h56M42 72h56M42 86h34" class="g-faint" />
        {/* curva de oportunidade */}
        <path d="M42 116l16-10 14 6 22-18" class="g-key" />
        {/* selo de encerramento */}
        <circle cx="118" cy="112" r="24" class="g-key" />
        <path d="M107 112l7 8 14-16" class="g-key" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .glyph :global(*) {
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .g-key {
    stroke: currentColor;
    opacity: 0.95;
  }
  .g-soft {
    stroke: currentColor;
    opacity: 0.55;
  }
  .g-faint {
    stroke: currentColor;
    opacity: 0.3;
  }
</style>
