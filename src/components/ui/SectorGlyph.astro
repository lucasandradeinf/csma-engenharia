---
/**
 * Desenhos de linha dos segmentos de atuacao.
 *
 * Fase 2 — refinamento pedido pelo cliente:
 *   - formato unico 200x150 (paisagem), linha de terreno em y=140 nos cinco,
 *     para que a familia leia como um conjunto e nao como cinco icones;
 *   - proporcao industrial, traco monolinear, sem contorno "fofo";
 *   - mineracao redesenhada: bancadas de cava a ceu aberto, rampa de acesso
 *     e caminhao fora-de-estrada — nao uma montanha generica.
 *
 * Hierarquia de traco: s-key (silhueta) · s-soft (secundario) · s-faint (textura).
 */
interface Props {
  name: 'mineracao' | 'siderurgia' | 'metalurgia' | 'celulose' | 'energia';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['sector-glyph', className]}
  viewBox="0 0 200 150"
  fill="none"
  aria-hidden="true"
  stroke="currentColor"
  stroke-width="1.2"
>
  {
    name === 'mineracao' && (
      <g>
        {/* cava a ceu aberto: bancadas descendo dos dois taludes ate a praca */}
        <path class="s-key" d="M6 48h18v23h14v23h12v23h10v23h72" />
        <path class="s-key" d="M194 48h-18v23h-14v23h-12v23h-10v23h-72" />
        {/* terreno original, antes da lavra */}
        <path class="s-faint" stroke-dasharray="5 4" d="M24 48h146" />
        {/* bermas dos patamares */}
        <path class="s-faint" d="M28 71v-5M42 94v-5M54 117v-5M166 71v-5M152 94v-5M140 117v-5" />
        {/* caminhao fora-de-estrada carregando na praca */}
        <g class="s-key">
          <path d="M100 108h34l-5 20h-29z" />
          <path d="M84 116h16v12H84z" />
          <path d="M84 128h50" />
          <circle cx="92" cy="133" r="7" />
          <circle cx="124" cy="132" r="8" />
        </g>
      </g>
    )
  }

  {
    name === 'siderurgia' && (
      <g>
        {/* alto-forno: goela, cuba, ventre e cadinho */}
        <path class="s-key" d="M52 140v-24l-8-20V72l8-38v-8h26v8l8 38v24l-8 20v24" />
        {/* cone de carregamento */}
        <path class="s-soft" d="M58 26v-10h14v10" />
        <path class="s-faint" d="M44 86h42M50 60h32M52 110h26" />
        {/* colunas do cadinho */}
        <path class="s-soft" d="M44 140v-18M86 140v-18" />
        {/* descida de gas ate o primeiro regenerador */}
        <path class="s-soft" d="M78 30h30a14 14 0 0 1 14 14v12" />
        {/* regeneradores */}
        <path class="s-key" d="M112 140V66a10 10 0 0 1 20 0v74" />
        <path class="s-soft" d="M142 140V80a9 9 0 0 1 18 0v60" />
        <path class="s-faint" d="M112 94h20M112 118h20M142 104h18M142 124h18" />
        {/* canal de corrida */}
        <path class="s-soft" d="M86 134h22" />
        <path class="s-key" d="M6 140h188" />
      </g>
    )
  }

  {
    name === 'metalurgia' && (
      <g>
        {/* ponte rolante */}
        <path class="s-key" d="M8 20h184" />
        <path class="s-soft" d="M8 28h184M8 20v10M192 20v10" />
        <path class="s-key" d="M78 28h28v8H78z" />
        <path class="s-soft" d="M92 36v8" />
        {/* panela de vazamento com munhoes */}
        <path class="s-key" d="M74 46h36l-6 40H80z" />
        <path class="s-soft" d="M74 46 92 38 110 46" />
        <circle class="s-key" cx="71" cy="54" r="5" />
        <circle class="s-key" cx="113" cy="54" r="5" />
        <path class="s-faint" d="M80 62h24" />
        {/* jato de vazamento e molde */}
        <path class="s-key" d="M104 86c4 12 6 20 6 32" />
        <path class="s-soft" d="M96 118h56v22H96z" />
        <path class="s-faint" d="M104 126h40M104 132h40" />
        {/* lingotes resfriando */}
        <path class="s-faint" d="M20 128h34v12H20zM26 120h24v8H26z" />
        <path class="s-key" d="M6 140h188" />
      </g>
    )
  }

  {
    name === 'celulose' && (
      <g>
        {/* digestor */}
        <path class="s-key" d="M30 46a20 20 0 0 1 40 0v64l-20 22-20-22z" />
        <path class="s-faint" d="M30 68h40M30 90h40" />
        <path class="s-soft" d="M50 132v8M38 140h24" />
        {/* rack de tubulacao ligando o digestor a torre */}
        <path class="s-key" d="M70 60h38M70 68h38" />
        <path class="s-soft" d="M84 68v16h12V68" />
        {/* torre de processo */}
        <path class="s-soft" d="M108 140V52a10 10 0 0 1 20 0v88" />
        <path class="s-faint" d="M108 78h20M108 106h20" />
        {/* chamine */}
        <path class="s-faint" d="M152 140V38h12v102M152 62h12" />
        <path class="s-key" d="M6 140h188" />
      </g>
    )
  }

  {
    name === 'energia' && (
      <g>
        {/* torre de transmissao */}
        <path class="s-key" d="M30 140 52 34 74 140M52 34v-8" />
        <path class="s-soft" d="M34 118h36M40 92h24M45 68h14" />
        <path class="s-faint" d="M34 118 64 92M40 92 70 118M40 92 59 68M45 68 64 92" />
        {/* portico da subestacao */}
        <path class="s-key" d="M104 140V44M172 140V44M100 44h76" />
        <path class="s-soft" d="M118 44v12M140 44v12M162 44v12M104 58h68" />
        <path class="s-faint" d="M115 48h6M137 48h6M159 48h6M115 53h6M137 53h6M159 53h6" />
        {/* transformador de forca */}
        <path class="s-key" d="M116 100h44v40h-44z" />
        <path class="s-soft" d="M116 108h-8v24h8M160 108h8v24h-8" />
        <path class="s-soft" d="M126 100v-8M138 100v-8M150 100v-8" />
        <path class="s-faint" d="M123 92h6M135 92h6M147 92h6" />
        <path class="s-key" d="M6 140h188" />
      </g>
    )
  }
</svg>

<style>
  .sector-glyph {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sector-glyph :global(*) {
    vector-effect: non-scaling-stroke;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }
  .s-key { opacity: 1; }
  .s-soft { opacity: 0.6; }
  .s-faint { opacity: 0.32; }
</style>
