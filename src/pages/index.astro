---
/**
 * HOME DE PRODUÇÃO — `/`
 *
 * O cliente escolheu a DIREÇÃO 02 ("arcadis"), então a raiz do site é ela.
 * A página inteira vive em `src/variants/arcadis/Pagina.astro`; aqui só se
 * declara a rota. A rota histórica `/arcadis/` renderiza o mesmo componente.
 *
 * `indexavel` é a única diferença entre as duas: a raiz entra nos buscadores,
 * a rota histórica continua `noindex` para não duplicar o site.
 */
import Pagina from '../variants/arcadis/Pagina.astro';
---

<Pagina indexavel />
