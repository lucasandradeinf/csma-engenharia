---
/**
 * Nossa abordagem + Estudo de Construtibilidade — paginas 4 e 12 da
 * apresentacao revisada.
 *
 * A abordagem e o unico momento de cor forte da direcao: um bloco navy com a
 * cadeia de quatro elos exatamente como o PDF a declara (Engenharia ·
 * Construtibilidade · Simulacao 3D e 4D · Workshop final). As duas etapas
 * extras que o site antigo mostrava nao existem na apresentacao e sairam.
 *
 * Logo abaixo, de volta ao off-white, o capitulo novo da revisao: o Estudo
 * de Construtibilidade, que e a proposta de valor da CSMA por escrito.
 */
import { abordagem as a, estudo as e } from './conteudo';
---

<!-- ============================ ABORDAGEM ============================ -->
<section class="bloco bloco--navy abordagem" id="abordagem" aria-labelledby="t-abordagem">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{a.eyebrow}</p>
      <h2 class="h2" id="t-abordagem" data-e style="--atraso:60ms">{a.title}</h2>
      <p class="lead" data-e style="--atraso:140ms">{a.lead}</p>
    </div>

    <ol class="cadeia" data-eg>
      {
        a.stages.map((s) => (
          <li class="elo">
            <span class="elo__n">{s.idx}</span>
            <span class="elo__nome">{s.label}</span>
          </li>
        ))
      }
    </ol>

    <p class="abordagem__frase" data-e>{a.statement}</p>
  </div>
</section>

<!-- ==================== ESTUDO DE CONSTRUTIBILIDADE ==================== -->
<section class="bloco bloco--areia estudo" id="construtibilidade" aria-labelledby="t-estudo">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{e.eyebrow}</p>
      <h2 class="h2" id="t-estudo" data-e style="--atraso:60ms">{e.title}</h2>
      <p class="lead estudo__lead" data-e style="--atraso:140ms">{e.lead}</p>
    </div>

    <ul class="estudo__grade" data-eg>
      {
        e.pillars.map((p) => (
          <li class="pilar-e">
            <span class="pilar-e__n">{p.idx}</span>
            <h3 class="h4 pilar-e__titulo">{p.title}</h3>
            <p class="min pilar-e__txt">{p.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="estudo__fecho" data-e>{e.closing}</p>
  </div>
</section>

<style>
  /* ---------------- abordagem (navy) ---------------- */
  .cadeia {
    display: grid;
    gap: 1px;
    background: var(--fio);
    border-block: 1px solid var(--fio);
  }
  @media (min-width: 40rem) {
    .cadeia { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .cadeia { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .elo {
    position: relative;
    background: var(--navy);
    padding: var(--e-6) var(--e-5) var(--e-7);
    display: grid;
    gap: var(--e-4);
    align-content: start;
    min-height: 9.5rem;
  }
  .elo__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #7ea2d6;
    font-variant-numeric: tabular-nums;
  }
  .elo__nome {
    font-size: var(--t-h3);
    font-weight: 600;
    letter-spacing: -0.024em;
    line-height: 1.15;
    color: #fff;
    max-width: 14ch;
  }

  .abordagem__frase {
    margin-top: var(--e-8);
    font-size: var(--t-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.32;
    color: #fff;
    max-width: 34ch;
  }

  /* ---------------- estudo de construtibilidade ---------------- */
  .estudo__lead { max-width: 58ch; }

  .estudo__grade {
    display: grid;
    gap: var(--e-6);
  }
  @media (min-width: 52rem) {
    .estudo__grade { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--e-7); }
  }

  .pilar-e {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: var(--e-4);
    border-top: 2px solid var(--navy);
  }
  .pilar-e__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tinta-fraca);
    font-variant-numeric: tabular-nums;
  }
  .pilar-e__titulo { max-width: 20ch; }
  .pilar-e__txt { max-width: 38ch; }

  .estudo__fecho {
    margin-top: var(--e-8);
    padding-top: var(--e-5);
    border-top: 1px solid var(--fio-forte);
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.014em;
    line-height: 1.5;
    color: var(--tinta);
    max-width: 52ch;
  }
</style>
