---
/**
 * O cenario atual — pagina 3 da apresentacao revisada.
 *
 * Cinco cartoes limpos sobre branco. Sem sombra e sem elevacao no hover: o
 * cliente pediu menos peso visual, entao a unica resposta e o fio mudando
 * de cor.
 */
import { cenario } from './conteudo';
---

<section class="bloco desafio" id="desafio" aria-labelledby="t-desafio">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{cenario.eyebrow}</p>
      <h2 class="h2" id="t-desafio" data-e style="--atraso:60ms">{cenario.title}</h2>
      <p class="lead" data-e style="--atraso:140ms">{cenario.lead}</p>
    </div>

    <ul class="desafio__cartoes" data-eg>
      {
        cenario.items.map((it) => (
          <li class="cartao">
            <span class="cartao__n">{it.idx}</span>
            <h3 class="h4 cartao__titulo">{it.title}</h3>
            <p class="min">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .desafio__cartoes {
    display: grid;
    gap: 1px;
    background: var(--fio);
    border-block: 1px solid var(--fio);
  }
  @media (min-width: 44rem) {
    .desafio__cartoes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .desafio__cartoes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* Cinco cartoes numa grade par: o ultimo ocupa a celula que sobraria. */
  @media (min-width: 44rem) {
    .cartao:last-child { grid-column: span 2; }
    .cartao:last-child .min { max-width: 52ch; }
  }

  .cartao {
    background: var(--branco);
    padding: var(--e-6) var(--e-5) var(--e-7);
    display: grid;
    gap: 0.7rem;
    align-content: start;
    min-height: 12rem;
    transition: background var(--dur-1) var(--suave);
  }
  .cartao:hover { background: var(--areia); }
  .cartao__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tinta-fraca);
    font-variant-numeric: tabular-nums;
  }
  .cartao__titulo { margin-top: 0.1rem; }
  .cartao .min { max-width: 36ch; }
</style>
