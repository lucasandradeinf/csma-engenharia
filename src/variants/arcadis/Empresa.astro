---
/**
 * Quem somos — pagina 2 da apresentacao revisada.
 *
 * A faixa fotografica que existia aqui foi removida a pedido do cliente:
 * o inicio do site nao tem mais fotografia decorativa. O capitulo e agora
 * texto institucional em duas colunas generosas.
 */
import { quemSomos } from './conteudo';
---

<section class="bloco quem" id="a-csma" aria-labelledby="t-quem">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{quemSomos.eyebrow}</p>
      <h2 class="h2" id="t-quem" data-e style="--atraso:60ms">{quemSomos.title}</h2>
      <p class="lead" data-e style="--atraso:140ms">{quemSomos.lead}</p>
    </div>

    <div class="quem__blocos" data-eg>
      {
        quemSomos.blocks.map((b) => (
          <article class="quem__bloco">
            <h3 class="h3">{b.label}</h3>
            <p class="corpo">{b.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quem__blocos {
    display: grid;
    gap: var(--e-6);
  }
  @media (min-width: 56rem) {
    .quem__blocos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-8);
    }
  }
  .quem__bloco {
    display: grid;
    gap: var(--e-4);
    align-content: start;
    padding-top: var(--e-5);
    border-top: 2px solid var(--navy);
  }
  .quem__bloco .corpo { max-width: 46ch; }
</style>
