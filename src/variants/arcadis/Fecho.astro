---
/**
 * Beneficios, contato e rodape — paginas 11 e 13 da apresentacao revisada.
 *
 * A pagina 11 traz apenas os seis beneficios (a coluna "o que costuma
 * acontecer" era leitura do site antigo, nao da apresentacao — saiu). A
 * pagina 13 ganhou telefone, que agora acompanha o e-mail no fecho e no
 * rodape.
 */
import Mark from '../_shared/Mark.astro';
import { marca, resultados, fecho } from './conteudo';

const navRodape = [
  {
    titulo: 'A CSMA',
    itens: [
      { rotulo: 'Quem somos', href: '#a-csma' },
      { rotulo: 'Vídeo institucional', href: '#video' },
      { rotulo: 'O cenário atual', href: '#desafio' },
      { rotulo: 'Nossa abordagem', href: '#abordagem' },
    ],
  },
  {
    titulo: 'Soluções',
    itens: [
      { rotulo: 'Estudo de construtibilidade', href: '#construtibilidade' },
      { rotulo: 'Como geramos valor', href: '#solucoes' },
      { rotulo: 'Entregáveis', href: '#entregaveis' },
      { rotulo: 'Metodologia', href: '#metodologia' },
    ],
  },
  {
    titulo: 'Alcance',
    itens: [
      { rotulo: 'Cases', href: '#cases' },
      { rotulo: 'Corpo técnico', href: '#equipe' },
      { rotulo: 'Segmentos', href: '#segmentos' },
      { rotulo: 'Resultados', href: '#resultados' },
    ],
  },
] as const;

const ano = new Date().getFullYear();
---

<!-- ============================ RESULTADOS ============================ -->
<section class="bloco resultados" id="resultados" aria-labelledby="t-res">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{resultados.eyebrow}</p>
      <h2 class="h2" id="t-res" data-e style="--atraso:60ms">{resultados.title}</h2>
      <p class="lead" data-e style="--atraso:140ms">{resultados.lead}</p>
    </div>

    <ul class="beneficios" data-eg>
      {
        resultados.items.map((b) => (
          <li class="beneficio">
            <span class="beneficio__n">{b.idx}</span>
            <p class="beneficio__txt">{b.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ============================ CONTATO ============================ -->
<section class="bloco bloco--navy contato" id="contato" aria-labelledby="t-contato">
  <div class="faixa contato__grade">
    <div>
      <p class="rotulo" data-e>{fecho.eyebrow}</p>
      <h2 class="h1 contato__frase" id="t-contato" data-e style="--atraso:60ms">
        {fecho.statement}
      </h2>
    </div>

    <div class="contato__lado" data-e style="--atraso:160ms">
      <p class="lead contato__pergunta">{fecho.question}</p>
      <a class="btn btn--claro" href={fecho.cta.href}>
        {fecho.cta.label}
        <svg viewBox="0 0 20 12" fill="none" aria-hidden="true">
          <path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
      <div class="contato__dados">
        <a class="contato__linha" href={`mailto:${marca.email}`}>{marca.email}</a>
        <a class="contato__linha" href={marca.phoneHref}>{marca.phone}</a>
      </div>
    </div>
  </div>
</section>

<!-- ============================ RODAPÉ ============================ -->
<footer class="rodape">
  <div class="faixa">
    <div class="rodape__grade">
      <div class="rodape__marca">
        <span class="rodape__marca-svg"><Mark title="CSMA Engenharia" travessao="#7ea2d6" /></span>
        <p class="rodape__assinatura">{marca.signature}</p>
        <a class="rodape__mail" href={`mailto:${marca.email}`}>{marca.email}</a>
        <a class="rodape__mail" href={marca.phoneHref}>{marca.phone}</a>
      </div>

      {
        navRodape.map((col) => (
          <nav class="rodape__col" aria-label={col.titulo}>
            <p class="rodape__col-titulo">{col.titulo}</p>
            <ul>
              {col.itens.map((i) => (
                <li><a href={i.href}>{i.rotulo}</a></li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="rodape__base">
      <span>© {ano} {marca.legalName}</span>
      <span>Construtibilidade · Planejamento · Gestão da implantação</span>
    </div>
  </div>
</footer>

<style>
  /* ---------------- resultados ---------------- */
  .beneficios {
    display: grid;
    gap: 1px;
    background: var(--fio);
    border-block: 1px solid var(--fio);
  }
  @media (min-width: 44rem) {
    .beneficios { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .beneficios { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .beneficio {
    background: var(--branco);
    padding: var(--e-6) var(--e-5) var(--e-7);
    display: grid;
    gap: var(--e-4);
    align-content: start;
    min-height: 10.5rem;
    transition: background var(--dur-1) var(--suave);
  }
  .beneficio:hover { background: var(--areia); }
  .beneficio__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tinta-fraca);
    font-variant-numeric: tabular-nums;
  }
  .beneficio__txt {
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.016em;
    line-height: 1.4;
    color: var(--tinta);
    max-width: 26ch;
  }

  /* ---------------- contato ---------------- */
  .contato__grade { display: grid; gap: var(--e-7); }
  @media (min-width: 62rem) {
    .contato__grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--e-8);
      align-items: end;
    }
  }
  .contato__frase { margin-top: var(--e-4); max-width: 16ch; }
  .contato__lado { display: grid; gap: var(--e-5); justify-items: start; }
  .contato__pergunta { color: #c6cedb; max-width: 26ch; }
  .contato__dados { display: grid; gap: 0.6rem; justify-items: start; }
  .contato__linha {
    font-size: var(--t-min);
    color: #c6cedb;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 2px;
  }
  .contato__linha:hover { color: #fff; border-bottom-color: #fff; }

  /* ---------------- rodapé ---------------- */
  .rodape {
    background: var(--navy-fundo);
    color: #fff;
    padding-block: var(--e-8) var(--e-5);
  }
  .rodape__grade {
    display: grid;
    gap: var(--e-6);
    padding-bottom: var(--e-7);
  }
  @media (min-width: 56rem) {
    .rodape__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 72rem) {
    .rodape__grade { grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr)); gap: var(--e-7); }
  }

  .rodape__marca { display: grid; gap: var(--e-4); align-content: start; justify-items: start; }
  .rodape__marca-svg { display: block; width: 112px; color: #fff; }
  .rodape__assinatura { font-size: var(--t-min); color: #9aa7ba; max-width: 30ch; }
  .rodape__mail {
    font-size: var(--t-min);
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 2px;
  }
  .rodape__mail:hover { border-bottom-color: #fff; }

  .rodape__col-titulo {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7ea2d6;
    margin-bottom: var(--e-4);
  }
  .rodape__col ul { display: grid; gap: 0.55rem; }
  .rodape__col a {
    font-size: var(--t-min);
    color: #c6cedb;
    transition: color var(--dur-1) var(--suave);
  }
  .rodape__col a:hover { color: #fff; }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: var(--e-5);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.75rem;
    color: #8593a8;
  }
</style>
