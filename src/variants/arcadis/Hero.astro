---
/**
 * Abertura — direcao 02 (versao escolhida pelo cliente).
 *
 * O cliente pediu para tirar as fotografias do inicio do site: a abertura e
 * agora inteiramente tipografica. Uma coluna de texto sobre branco, muito
 * espaco negativo e a faixa dos quatro pilares da sigla. A fotografia volta
 * so nos Cases, mais abaixo.
 */
import { capa, marca } from './conteudo';
---

<section class="abre" id="topo">
  <div class="faixa abre__int">
    <div class="abre__texto">
      <p class="rotulo abre__rotulo" data-e style="--atraso:40ms">{marca.legalName}</p>

      <h1 class="h1 abre__titulo" data-e style="--atraso:120ms">{capa.headline}</h1>

      <p class="lead abre__lead" data-e style="--atraso:200ms">{capa.sub}</p>

      <div class="abre__acoes" data-e style="--atraso:280ms">
        <a class="btn" href={capa.ctaPrimary.href}>
          {capa.ctaPrimary.label}
          <svg viewBox="0 0 20 12" fill="none" aria-hidden="true">
            <path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
        <a class="btn btn--linha" href={capa.ctaSecondary.href}>{capa.ctaSecondary.label}</a>
      </div>
    </div>
  </div>

  <!-- quatro pilares: o que a sigla significa -->
  <div class="pilares">
    <div class="faixa pilares__grade" data-eg>
      {
        capa.pillars.map((p) => (
          <div class="pilar">
            <span class="pilar__en">{p.en}</span>
            <span class="pilar__pt">{p.pt}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .abre { background: var(--branco); }

  .abre__int {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--e-8) var(--e-9);
  }
  @media (min-width: 60rem) {
    .abre__int {
      min-height: calc(100svh - var(--topo) - var(--util) - 7rem);
      padding-block: var(--e-9);
    }
  }

  .abre__texto { width: 100%; max-width: 52rem; }

  .abre__rotulo {
    padding-top: var(--e-4);
    border-top: 2px solid var(--navy);
    display: inline-block;
  }

  .abre__titulo {
    margin-top: var(--e-5);
    max-width: 17ch;
  }
  .abre__lead {
    margin-top: var(--e-6);
    max-width: 48ch;
  }
  .abre__acoes {
    margin-top: var(--e-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  /* --- pilares --- */
  .pilares {
    border-top: 1px solid var(--fio);
    border-bottom: 1px solid var(--fio);
    background: var(--areia);
  }
  .pilares__grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 52rem) {
    .pilares__grade { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .pilar {
    padding: var(--e-5) var(--e-4) var(--e-5) var(--e-4);
    display: grid;
    gap: 0.25rem;
    border-left: 1px solid var(--fio);
  }
  .pilar:first-child { border-left: 0; padding-left: 0; }
  @media (max-width: 51.9375rem) {
    .pilar:nth-child(odd) { border-left: 0; padding-left: 0; }
  }
  .pilar__en {
    font-size: var(--t-h4);
    font-weight: 600;
    letter-spacing: -0.016em;
    color: var(--navy);
  }
  .pilar__pt {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-fraca);
  }
</style>
