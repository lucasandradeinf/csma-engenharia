---
import './arcadis.css';
import { withBase } from '../../lib/url';
import { fontFaces, fontPreloads } from '../../lib/fonts';
import { marca } from './conteudo';

/* Uma família só: a direção institucional não mistura tipografias. */
const FAMILIES = ['sans'] as const;
const faces = fontFaces(FAMILIES);
const preloads = fontPreloads(FAMILIES);

const title = marca.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site
  ? new URL(withBase('og.png'), Astro.site).href
  : withBase('og.png');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={marca.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#122744" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={marca.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={marca.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${marca.legalName} — ${marca.signature}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={marca.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={withBase('favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />

    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={faces}></style>
  </head>

  <body>
    <a class="pular" href="#conteudo">Ir para o conteúdo</a>
    <slot />

    <script>
      const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alvos = document.querySelectorAll<HTMLElement>('[data-e], [data-eg], [data-observa]');

      if (reduzido) {
        alvos.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        alvos.forEach((el) => io.observe(el));
      }
    </script>

  </body>
</html>
