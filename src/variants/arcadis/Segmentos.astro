---
/**
 * Segmentos de atuação — direção 02.
 *
 * Leitura editorial e corporativa: uma lista de cinco linhas em tipografia
 * grande, com um painel fixo à direita que troca conforme o segmento em foco.
 * Enquanto a fotografia real não existe, o painel mostra o desenho técnico.
 */
import { Image } from 'astro:assets';
import { sectors } from '../../data/site';
import { sectorPhoto } from '../../lib/photos';
import SectorMark from '../_shared/SectorMark.astro';

const itens = sectors.items.map((s) => ({ ...s, foto: sectorPhoto(s.photo) }));
---

<section class="bloco bloco--areia segmentos" id="segmentos" aria-labelledby="t-seg">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{sectors.eyebrow}</p>
      <h2 class="h2" id="t-seg" data-e style="--atraso:60ms">{sectors.title}</h2>
      <p class="lead" data-e style="--atraso:140ms">{sectors.lead}</p>
    </div>

    <div class="segmentos__grade" data-segmentos>
      <ol class="segmentos__lista" data-eg>
        {
          itens.map((s, i) => (
            <li>
              <a
                class:list={['linha', i === 0 && 'is-foco']}
                href="#segmentos"
                data-seg={i}
              >
                <span class="linha__n">{s.idx}</span>
                <span class="linha__nome">{s.name}</span>
                <span class="linha__lead">{s.lead}</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="segmentos__painel" aria-hidden="true">
        <div class="segmentos__quadro">
          {
            itens.map((s, i) => (
              <div class:list={['placa', i === 0 && 'is-foco']} data-placa={i}>
                {s.foto ? (
                  <Image
                    class="placa__foto"
                    src={s.foto}
                    alt=""
                    quality={82}
                    format="webp"
                    widths={[560, 840, 1120]}
                    sizes="(min-width: 66rem) 32rem, 90vw"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <SectorMark name={s.glyph} class="placa__marca" detail="full" />
                )}
              </div>
            ))
          }
        </div>
        <p class="min segmentos__nota">
          Vivência de campo da equipe da CSMA em projetos de grande porte
          nesses cinco segmentos.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-segmentos]');
  if (raiz) {
    const linhas = [...raiz.querySelectorAll<HTMLElement>('[data-seg]')];
    const placas = [...raiz.querySelectorAll<HTMLElement>('[data-placa]')];

    const focar = (i: number) => {
      linhas.forEach((l, j) => l.classList.toggle('is-foco', i === j));
      placas.forEach((p, j) => p.classList.toggle('is-foco', i === j));
    };

    linhas.forEach((l, i) => {
      l.addEventListener('mouseenter', () => focar(i));
      l.addEventListener('focus', () => focar(i));
    });
  }
</script>

<style>
  .segmentos__grade { display: grid; gap: var(--e-6); }
  @media (min-width: 66rem) {
    .segmentos__grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--e-8);
      align-items: start;
    }
  }

  /* --- lista --- */
  .segmentos__lista { display: grid; }
  .linha {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.3rem var(--e-4);
    padding-block: var(--e-5);
    border-top: 1px solid var(--fio-forte);
    transition: color var(--dur-1) var(--suave);
  }
  .segmentos__lista li:last-child .linha { border-bottom: 1px solid var(--fio-forte); }

  .linha__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tinta-fraca);
    padding-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .linha__nome {
    font-size: clamp(1.375rem, 0.9rem + 1.9vw, 2.375rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.08;
    color: var(--tinta);
    transition: color var(--dur-1) var(--suave);
  }
  .linha__lead {
    grid-column: 2;
    font-size: var(--t-min);
    color: var(--tinta-media);
    max-width: 44ch;
    line-height: 1.6;
  }
  .linha.is-foco .linha__nome,
  .linha:hover .linha__nome { color: var(--navy); }
  .linha.is-foco .linha__n { color: var(--navy); }

  /* --- painel --- */
  .segmentos__painel { display: none; }
  @media (min-width: 66rem) {
    .segmentos__painel {
      display: block;
      position: sticky;
      top: calc(var(--topo) + var(--e-5));
    }
  }
  .segmentos__quadro {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--branco);
    border: 1px solid var(--fio);
    border-radius: var(--raio);
    overflow: hidden;
  }
  .placa {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--e-6);
    opacity: 0;
    transition: opacity var(--dur-2) var(--suave);
  }
  .placa.is-foco { opacity: 1; }
  .placa__foto { width: 100%; height: 100%; object-fit: cover; }
  .placa__marca {
    color: var(--navy);
    --mark-key: 1.3;
    --mark-key-o: 0.9;
    --mark-soft: 1.1;
    --mark-soft-o: 0.5;
    --mark-faint: 1;
    --mark-faint-o: 0.22;
  }
  .segmentos__nota { margin-top: var(--e-4); max-width: 38ch; }
</style>
