---
/**
 * Onde atuamos & diferenciais — pagina 10 da apresentacao revisada.
 *
 * A revisao juntou "Segmentos de Atuacao" e "Diferenciais" numa pagina so, e
 * o site acompanha. O painel de imagens que existia aqui saiu: a apresentacao
 * so declara os cinco nomes, e o cliente pediu menos fotografia decorativa.
 * Fica a leitura editorial — cinco segmentos em tipografia grande, seis
 * diferenciais em lista conferida.
 */
import { segmentos as s } from './conteudo';
---

<section class="bloco bloco--areia atuacao" id="segmentos" aria-labelledby="t-atuacao">
  <div class="faixa">
    <div class="secao">
      <p class="rotulo secao__rotulo" data-e>{s.eyebrow}</p>
      <h2 class="h2" id="t-atuacao" data-e style="--atraso:60ms">{s.title}</h2>
    </div>

    <div class="atuacao__grade">
      <!-- segmentos -->
      <div class="atuacao__col">
        <p class="rotulo" data-e>{s.sectorsLabel}</p>
        <ol class="setores" data-eg>
          {
            s.sectors.map((nome, i) => (
              <li class="setor">
                <span class="setor__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="setor__nome">{nome}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- diferenciais -->
      <div class="atuacao__col" id="diferenciais">
        <p class="rotulo" data-e>{s.differentialsLabel}</p>
        <ul class="diferenciais" data-eg>
          {
            s.differentials.map((d) => (
              <li class="dif">
                <span class="dif__marca" aria-hidden="true">
                  <svg viewBox="0 0 16 12" fill="none">
                    <path d="M1 6.2 5.6 10.8 15 1.4" stroke="currentColor" stroke-width="2" />
                  </svg>
                </span>
                <p class="dif__txt">{d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .atuacao__grade { display: grid; gap: var(--e-8); }
  @media (min-width: 62rem) {
    .atuacao__grade {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--e-9);
      align-items: start;
    }
  }

  /* --- segmentos --- */
  .setores { display: grid; margin-top: var(--e-4); }
  .setor {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--e-4);
    padding-block: var(--e-4);
    border-top: 1px solid var(--fio-forte);
  }
  .setor:last-child { border-bottom: 1px solid var(--fio-forte); }
  .setor__n {
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--tinta-fraca);
    font-variant-numeric: tabular-nums;
  }
  .setor__nome {
    font-size: clamp(1.375rem, 0.95rem + 1.6vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.1;
    color: var(--navy);
  }

  /* --- diferenciais --- */
  .diferenciais {
    display: grid;
    gap: var(--e-5);
    margin-top: var(--e-4);
  }
  @media (min-width: 44rem) {
    .diferenciais { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-5) var(--e-7); }
  }
  .dif {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: var(--e-4);
    padding-top: var(--e-4);
    border-top: 1px solid var(--fio-forte);
  }
  .dif__marca { color: var(--navy); padding-top: 0.4rem; }
  .dif__marca svg { width: 1.05rem; }
  .dif__txt {
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.014em;
    line-height: 1.4;
    max-width: 28ch;
  }
</style>
