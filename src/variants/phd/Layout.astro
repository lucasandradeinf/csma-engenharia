---
import './phd.css';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
import { fontFaces, fontPreloads } from '../../lib/fonts';
import Switcher from '../_shared/Switcher.astro';

const FAMILIES = ['sans', 'mono'] as const;
const faces = fontFaces(FAMILIES);
const preloads = fontPreloads(FAMILIES);

const title = `${site.legalName} — Construtibilidade | Direção 01`;
const description = site.description;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0e1113" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={withBase('favicon.ico')} sizes="48x48" />

    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={faces}></style>
  </head>

  <body>
    <a class="pular" href="#conteudo">Ir para o conteúdo</a>
    <div class="progresso" aria-hidden="true"><span data-progresso></span></div>
    <slot />
    <Switcher atual="phd" />

    <script>
      /* Revelação: um único observer para a página inteira. */
      const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alvos = document.querySelectorAll<HTMLElement>(
        '[data-r], [data-rg], [data-fio], [data-observa]'
      );

      if (reduzido) {
        alvos.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.06 }
        );
        alvos.forEach((el) => io.observe(el));
      }

      /* Barra de avanço da leitura — fio de óxido no topo. */
      const barra = document.querySelector<HTMLElement>('[data-progresso]');
      if (barra) {
        let pendente = false;
        const medir = () => {
          const alcance = document.documentElement.scrollHeight - window.innerHeight;
          const razao = alcance > 0 ? window.scrollY / alcance : 0;
          barra.style.transform = `scaleX(${Math.min(1, Math.max(0, razao))})`;
          pendente = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (pendente) return;
            pendente = true;
            requestAnimationFrame(medir);
          },
          { passive: true }
        );
        medir();
      }
    </script>

    <style is:global>
      .progresso {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 60;
        background: transparent;
        pointer-events: none;
      }
      .progresso span {
        display: block;
        height: 100%;
        background: var(--oxido);
        transform: scaleX(0);
        transform-origin: left;
      }
    </style>
  </body>
</html>
