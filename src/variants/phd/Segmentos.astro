---
/**
 * Capítulo 08 — segmentos de atuação.
 *
 * Leitura técnica: cinco pranchas verticais lado a lado, sangrando de borda a
 * borda. Cada prancha traz o desenho monolinear do segmento; quando a
 * fotografia real existir em `src/assets/sectors/`, ela entra no lugar do
 * desenho sem que este arquivo mude.
 */
import { Image } from 'astro:assets';
import { sectors } from '../../data/site';
import { sectorPhoto } from '../../lib/photos';
import SectorMark from '../_shared/SectorMark.astro';

const itens = sectors.items.map((s) => ({ ...s, foto: sectorPhoto(s.photo) }));
---

<section class="cap cap--sangra segmentos" id="segmentos" aria-labelledby="t-seg">
  <div class="malha" aria-hidden="true"></div>

  <div class="faixa">
    <div class="cabec cabec--largo">
      <p class="cabec__cota">08 / {sectors.eyebrow}</p>
      <h2 class="enunciado" id="t-seg" data-r>{sectors.title}</h2>
      <p class="lead segmentos__lead" data-r style="--atraso:120ms">{sectors.lead}</p>
    </div>
  </div>

  <ul class="segmentos__tira" data-observa>
    {
      itens.map((s, i) => (
        <li class="prancha" style={`--i:${i}`}>
          <div class="prancha__quadro">
            {s.foto ? (
              <Image
                class="prancha__foto"
                src={s.foto}
                alt=""
                quality={80}
                format="webp"
                widths={[420, 640, 900]}
                sizes="(min-width: 62rem) 20vw, 60vw"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <SectorMark name={s.glyph} class="prancha__marca" detail="full" />
            )}
            <span class="prancha__mira" aria-hidden="true" />
          </div>

          <div class="prancha__texto">
            <span class="dado dado--oxido">{s.idx}</span>
            <h3 class="prancha__nome">{s.name}</h3>
            <p class="prancha__lead">{s.lead}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .segmentos {
    background: var(--grafite);
    border-top: 1px solid var(--fio);
  }
  .segmentos__lead { max-width: 44ch; }

  .segmentos__tira {
    display: grid;
    gap: 1px;
    background: var(--fio);
    border-block: 1px solid var(--fio);
  }
  @media (min-width: 44rem) {
    .segmentos__tira { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .segmentos__tira { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  .prancha {
    background: var(--grafite);
    display: grid;
    grid-template-rows: auto 1fr;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 640ms var(--saida), transform 640ms var(--saida), background var(--dur-1) var(--saida);
    transition-delay: calc(var(--i) * 90ms + 160ms);
  }
  .segmentos__tira.is-in .prancha { opacity: 1; transform: none; }
  .prancha:hover { background: var(--grafite-3); }

  .prancha__quadro {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    padding: var(--e-5);
    border-bottom: 1px solid var(--fio);
    overflow: hidden;
  }
  @media (min-width: 68rem) {
    .prancha__quadro { aspect-ratio: 3 / 3.4; }
  }

  .prancha__marca {
    color: var(--osso);
    --mark-key: 1.4;
    --mark-key-o: 0.92;
    --mark-soft: 1.1;
    --mark-soft-o: 0.55;
    --mark-faint: 1;
    --mark-faint-o: 0.26;
    transition: color var(--dur-1) var(--saida);
  }
  .prancha:hover .prancha__marca { color: var(--oxido-claro); }

  .prancha__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.08) brightness(0.82);
    transition: filter var(--dur-2) var(--saida), transform var(--dur-2) var(--saida);
  }
  .prancha:hover .prancha__foto { filter: grayscale(0.2) contrast(1.05) brightness(0.95); transform: scale(1.03); }

  /* Mira de prancha no canto — marca de registro, não decoração */
  .prancha__mira {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    width: 14px;
    height: 14px;
    border-top: 1px solid var(--oxido);
    border-left: 1px solid var(--oxido);
    opacity: 0.6;
  }

  .prancha__texto {
    padding: var(--e-5) var(--e-4) var(--e-6);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .prancha__nome {
    font-size: var(--t-h4);
    font-weight: 600;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.1;
  }
  .prancha__lead {
    font-size: var(--t-min);
    line-height: 1.62;
    color: var(--tinta-fraca);
  }
</style>
